# Copy this file to .env and adjust it. .env is gitignored, so secrets are safe there.

# The chat model you pulled with `ollama pull`.
MODEL=qwen3:4b-instruct-2507-q4_K_M

# To use a second provider side by side (Module 3, the hosted-models elective), put its
# settings in .env.<name>, e.g. .env.hf, and pass --profile <name>. All .env.* files except
# this one are gitignored.

# Module 8: the Slack app's two tokens (setup steps 4 and 5 in m08-slack/README.md). No quotes.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Or point every lesson at a hosted provider instead of Ollama:
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_...
